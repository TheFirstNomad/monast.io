# Public (client-side) backend config — safe to expose in the browser bundle.
# Real values are generated automatically by Lovable Cloud into .env.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Server-only secrets are NEVER stored in this repo or in .env.
# They live in backend secrets and are read by edge functions at runtime:
#   CIRCLE_API_KEY, SUPABASE_SERVICE_ROLE_KEY, LOVABLE_API_KEY, ...
